# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/social_analysis_db
# For development, you can use SQLite:
# DATABASE_URL=sqlite:///social_analysis.db

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_ENV=development

# Apify Configuration
APIFY_API_TOKEN=your-apify-api-token-here

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1/

# GitHub Configuration (optional)
GITHUB_TOKEN=your-github-token

# YouTube Configuration (optional)
YOUTUBE_API_KEY=your-youtube-api-key

# Web Discovery OSINT Configuration (optional)
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_CX=your-google-cse-cx-id
WEB_DISCOVERY_MAX_QUERIES=10
WEB_DISCOVERY_MAX_RESULTS_PER_QUERY=10

# Analysis Provider
# Set to 'openrouter'
ANALYSIS_PROVIDER=openrouter

# Security
BCRYPT_LOG_ROUNDS=12

# Application Settings
MAX_POSTS_PER_SCRAPE=1000
ANALYSIS_TIMEOUT=300
